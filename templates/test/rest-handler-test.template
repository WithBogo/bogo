func Test<struct_name>Handler_GetByID(t *testing.T) {
	t.Run("rejects a non numeric id", func(t *testing.T) {
		h := New<struct_name>Handler(context.Background(), &mock<struct_name>Service{})

		rec := do<struct_name>Request(h.Get<singular_name>ByID, http.MethodGet, "", httprouter.Params{{Key: "id", Value: "abc"}})

		if rec.Code != http.StatusBadRequest {
			t.Errorf("expected 400, got %d", rec.Code)
		}
	})

	t.Run("returns the entity", func(t *testing.T) {
		svc := &mock<struct_name>Service{
			getByIDFn: func(ctx context.Context, id int64) (dto.<struct_name>, error) {
				return dto.<struct_name>{ID: id}, nil
			},
		}
		h := New<struct_name>Handler(context.Background(), svc)

		rec := do<struct_name>Request(h.Get<singular_name>ByID, http.MethodGet, "", httprouter.Params{{Key: "id", Value: "1"}})

		if rec.Code != http.StatusOK {
			t.Errorf("expected 200, got %d", rec.Code)
		}
	})

	t.Run("returns 404 when the entity does not exist", func(t *testing.T) {
		svc := &mock<struct_name>Service{
			getByIDFn: func(ctx context.Context, id int64) (dto.<struct_name>, error) {
				return dto.<struct_name>{}, errors.New("<singular_name> not found")
			},
		}
		h := New<struct_name>Handler(context.Background(), svc)

		rec := do<struct_name>Request(h.Get<singular_name>ByID, http.MethodGet, "", httprouter.Params{{Key: "id", Value: "1"}})

		if rec.Code != http.StatusNotFound {
			t.Errorf("expected 404, got %d", rec.Code)
		}
	})
}

func Test<struct_name>Handler_Update(t *testing.T) {
	t.Run("rejects a non numeric id", func(t *testing.T) {
		svc := &mock<struct_name>Service{}
		h := New<struct_name>Handler(context.Background(), svc)

		rec := do<struct_name>Request(h.Update<singular_name>, http.MethodPut, valid<struct_name>Body, httprouter.Params{{Key: "id", Value: "abc"}})

		if rec.Code != http.StatusBadRequest {
			t.Errorf("expected 400, got %d", rec.Code)
		}
		if svc.updateCalls != 0 {
			t.Error("service must not be called for an invalid id")
		}
	})

	t.Run("uses the id from the url", func(t *testing.T) {
		var gotID int64
		svc := &mock<struct_name>Service{
			updateFn: func(ctx context.Context, entity dto.<struct_name>) error {
				gotID = entity.ID
				return nil
			},
		}
		h := New<struct_name>Handler(context.Background(), svc)

		rec := do<struct_name>Request(h.Update<singular_name>, http.MethodPut, valid<struct_name>Body, httprouter.Params{{Key: "id", Value: "8"}})

		if rec.Code != http.StatusOK {
			t.Fatalf("expected 200, got %d: %s", rec.Code, rec.Body.String())
		}
		if gotID != 8 {
			t.Errorf("expected entity id 8, got %d", gotID)
		}
	})
}

