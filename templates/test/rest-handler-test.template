// mock<struct_name>Service is a hand-rolled mock of the <entity_singular> service used by the handler
type mock<struct_name>Service struct {
	createFn  func(ctx context.Context, entity dto.<struct_name>) (int64, error)
	updateFn  func(ctx context.Context, entity dto.<struct_name>) error
	deleteFn  func(ctx context.Context, id int64) error
	getByIDFn func(ctx context.Context, id int64) (dto.<struct_name>, error)

	createCalls int
	updateCalls int
}

func (m *mock<struct_name>Service) Find(ctx context.Context, filter map[string]any, sort map[string]any, limit, offset int) (dto.<plural_name>, int64, error) {
	return nil, 0, nil
}

func (m *mock<struct_name>Service) Create(ctx context.Context, entity dto.<struct_name>) (int64, error) {
	m.createCalls++
	return m.createFn(ctx, entity)
}

func (m *mock<struct_name>Service) Update(ctx context.Context, entity dto.<struct_name>) error {
	m.updateCalls++
	return m.updateFn(ctx, entity)
}

func (m *mock<struct_name>Service) Delete(ctx context.Context, id int64) error {
	return m.deleteFn(ctx, id)
}

func (m *mock<struct_name>Service) GetByID(ctx context.Context, id int64) (dto.<struct_name>, error) {
	return m.getByIDFn(ctx, id)
}

// valid<struct_name>Body is a request body that satisfies every validation rule of the DTO
const valid<struct_name>Body = <valid_body>

func do<struct_name>Request(handle httprouter.Handle, method, body string, params httprouter.Params) *httptest.ResponseRecorder {
	req := httptest.NewRequest(method, "/<entity_plural>", strings.NewReader(body))
	rec := httptest.NewRecorder()
	handle(rec, req, params)
	return rec
}

