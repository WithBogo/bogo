	t.Run("rejects malformed json", func(t *testing.T) {
		svc := &mock<struct_name>Service{}
		h := New<struct_name>Handler(context.Background(), svc)

		rec := do<struct_name>Request(h.Create<singular_name>, http.MethodPost, "{not json", nil)

		if rec.Code != http.StatusBadRequest {
			t.Errorf("expected 400, got %d", rec.Code)
		}
		if svc.createCalls != 0 {
			t.Error("service must not be called for a malformed body")
		}
	})
<validation_failure_test>
	t.Run("creates the entity", func(t *testing.T) {
		svc := &mock<struct_name>Service{
			createFn: func(ctx context.Context, entity dto.<struct_name>) (int64, error) { return 42, nil },
		}
		h := New<struct_name>Handler(context.Background(), svc)

		rec := do<struct_name>Request(h.Create<singular_name>, http.MethodPost, valid<struct_name>Body, nil)

		if rec.Code != http.StatusCreated {
			t.Fatalf("expected 201, got %d: %s", rec.Code, rec.Body.String())
