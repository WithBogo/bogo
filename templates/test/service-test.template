func Test<service_name>_Find(t *testing.T) {
	t.Run("maps models to dtos and returns the total", func(t *testing.T) {
		repo := &mock<struct_name>Repo{
			findFn: func(ctx context.Context, filter, sort map[string]any, limit, offset int) ([]model.<struct_name>, int64, error) {
				var first, second model.<struct_name>
				first.ID = 1
				second.ID = 2
				return []model.<struct_name>{first, second}, 2, nil
			},
		}
		svc := New<service_name>(context.Background(), repo)

		got, total, err := svc.Find(context.Background(), nil, nil, 10, 0)
		if err != nil {
			t.Fatalf("unexpected error: %v", err)
		}
		if total != 2 || len(got) != 2 {
			t.Fatalf("expected 2 results with total 2, got %d results and total %d", len(got), total)
		}
		if got[0].ID != 1 || got[1].ID != 2 {
			t.Errorf("unexpected ids: %d, %d", got[0].ID, got[1].ID)
		}
	})

	t.Run("propagates repository errors", func(t *testing.T) {
		wantErr := errors.New("query failed")
		repo := &mock<struct_name>Repo{
			findFn: func(ctx context.Context, filter, sort map[string]any, limit, offset int) ([]model.<struct_name>, int64, error) {
				return nil, 0, wantErr
			},
		}
		svc := New<service_name>(context.Background(), repo)

		if _, _, err := svc.Find(context.Background(), nil, nil, 10, 0); !errors.Is(err, wantErr) {
			t.Errorf("expected %v, got %v", wantErr, err)
		}
	})
}
