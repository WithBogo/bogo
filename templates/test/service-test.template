package application

import (
	"context"
	"errors"
	"testing"

	"<module_name>/internal/application/dto"
	"<module_name>/internal/domain/model"
)

// mock<struct_name>Repo is a hand-rolled mock of the <entity_name> repository
type mock<struct_name>Repo struct {
	findFn    func(ctx context.Context, filter, sort map[string]any, limit, offset int) ([]model.<struct_name>, int64, error)
	createFn  func(ctx context.Context, entity *model.<struct_name>) error
	updateFn  func(ctx context.Context, entity model.<struct_name>) error
	deleteFn  func(ctx context.Context, id int64) error
	getByIDFn func(ctx context.Context, id int64) (model.<struct_name>, error)
}

func (m *mock<struct_name>Repo) Find(ctx context.Context, filter, sort map[string]any, limit, offset int) ([]model.<struct_name>, int64, error) {
	return m.findFn(ctx, filter, sort, limit, offset)
}

func (m *mock<struct_name>Repo) Create(ctx context.Context, entity *model.<struct_name>) error {
	return m.createFn(ctx, entity)
}

func (m *mock<struct_name>Repo) Update(ctx context.Context, entity model.<struct_name>) error {
	return m.updateFn(ctx, entity)
}

func (m *mock<struct_name>Repo) Delete(ctx context.Context, id int64) error {
	return m.deleteFn(ctx, id)
}

func (m *mock<struct_name>Repo) GetByID(ctx context.Context, id int64) (model.<struct_name>, error) {
	return m.getByIDFn(ctx, id)
}

func Test<service_name>_Create(t *testing.T) {
	t.Run("returns the id assigned by the repository", func(t *testing.T) {
		repo := &mock<struct_name>Repo{
			createFn: func(ctx context.Context, entity *model.<struct_name>) error {
				entity.ID = 7
				return nil
			},
		}
		svc := New<service_name>(context.Background(), repo)

		id, err := svc.Create(context.Background(), dto.<struct_name>{})
		if err != nil {
			t.Fatalf("unexpected error: %v", err)
		}
		if id != 7 {
			t.Errorf("expected id 7, got %d", id)
		}
	})

	t.Run("propagates repository errors", func(t *testing.T) {
		wantErr := errors.New("insert failed")
		repo := &mock<struct_name>Repo{
			createFn: func(ctx context.Context, entity *model.<struct_name>) error { return wantErr },
		}
		svc := New<service_name>(context.Background(), repo)

		if _, err := svc.Create(context.Background(), dto.<struct_name>{}); !errors.Is(err, wantErr) {
			t.Errorf("expected %v, got %v", wantErr, err)
		}
	})
}

func Test<service_name>_GetByID(t *testing.T) {
	t.Run("maps the model to a dto", func(t *testing.T) {
		repo := &mock<struct_name>Repo{
			getByIDFn: func(ctx context.Context, id int64) (model.<struct_name>, error) {
				var found model.<struct_name>
				found.ID = id
				return found, nil
			},
		}
		svc := New<service_name>(context.Background(), repo)

		got, err := svc.GetByID(context.Background(), 3)
		if err != nil {
			t.Fatalf("unexpected error: %v", err)
		}
		if got.ID != 3 {
			t.Errorf("expected id 3, got %d", got.ID)
		}
	})

	t.Run("propagates repository errors", func(t *testing.T) {
		wantErr := errors.New("<struct_name> not found")
		repo := &mock<struct_name>Repo{
			getByIDFn: func(ctx context.Context, id int64) (model.<struct_name>, error) {
				return model.<struct_name>{}, wantErr
			},
		}
		svc := New<service_name>(context.Background(), repo)

		if _, err := svc.GetByID(context.Background(), 3); !errors.Is(err, wantErr) {
			t.Errorf("expected %v, got %v", wantErr, err)
		}
	})
}

