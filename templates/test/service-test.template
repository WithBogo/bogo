		repo := &mock<struct_name>Repo{
			updateFn: func(ctx context.Context, entity model.<struct_name>) error {
				gotID = entity.ID
				return nil
			},
		}
		svc := New<service_name>(context.Background(), repo)

		if err := svc.Update(context.Background(), dto.<struct_name>{ID: 5}); err != nil {
			t.Fatalf("unexpected error: %v", err)
		}
